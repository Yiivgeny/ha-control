{
  "version": "2026.8",
  "rest": [
    {"operation": "/api/config", "method": "GET", "description": "Core configuration and version"},
    {"operation": "/api/states/{entity_id}", "methods": ["GET", "POST", "DELETE"], "description": "Read or set a state-machine value. POST does not command a physical device; use call_service for device control."},
    {"operation": "/api/services/{domain}/{service}", "method": "POST", "description": "Call a service; JSON body is service data; ?return_response requests response data. Live service schemas: ha_discover services."},
    {"operation": "/api/template", "method": "POST", "body": {"template": "Jinja template"}, "description": "Render a template using live HA state"},
    {"operation": "/api/history/period/{start}", "method": "GET", "params": ["filter_entity_id", "end_time", "minimal_response", "no_attributes", "significant_changes_only"], "description": "Recorder history; ISO timestamps with explicit timezone, comma-separated entity IDs"},
    {"operation": "/api/logbook/{start}", "method": "GET", "params": ["end_time", "entity"], "description": "Logbook events"},
    {"operation": "/api/config/core/check_config", "method": "POST", "description": "Validate HA configuration before reload/restart"},
    {"operation": "/api/config/automation/config/{id}", "methods": ["GET", "POST", "DELETE"], "description": "Read/save/delete YAML-backed automation; ID is the config id, not entity_id; POST body is the automation mapping"},
    {"operation": "/api/config/script/config/{id}", "methods": ["GET", "POST", "DELETE"], "description": "Read/save/delete script configuration"},
    {"operation": "/api/config/scene/config/{id}", "methods": ["GET", "POST", "DELETE"], "description": "Read/save/delete scene configuration"},
    {"operation": "/api/config/config_entries/flow", "methods": ["GET", "POST"], "description": "List/start integration config flows; POST {handler: domain, show_advanced_options: bool}; continue the returned flow_id using its live data_schema"},
    {"operation": "/api/config/config_entries/flow/{flow_id}", "methods": ["GET", "POST", "DELETE"], "description": "Read/advance/abort integration config flow"},
    {"operation": "/api/config/config_entries/options/flow", "method": "POST", "description": "Start options flow with {handler: entry_id}"},
    {"operation": "/api/config/config_entries/options/flow/{flow_id}", "methods": ["GET", "POST", "DELETE"], "description": "Read/advance/abort options flow"},
    {"operation": "/api/config/config_entries/entry/{entry_id}", "methods": ["GET", "DELETE"], "description": "Entry resources; availability of methods is version dependent; HA is authoritative"},
    {"operation": "/api/error_log", "method": "GET", "description": "Core error log"},
    {"operation": "/api/camera_proxy/{entity_id}", "method": "GET", "description": "Camera image; binary responses are encoded as base64"}
  ],
  "supervisor": [
    {"operation": "/info", "method": "GET", "description": "Supervisor and host versions"},
    {"operation": "/core/info", "method": "GET", "description": "Core version, settings and state"},
    {"operation": "/core/stats", "method": "GET", "description": "Core CPU and memory statistics"},
    {"operation": "/core/logs", "method": "GET", "description": "Core container logs"},
    {"operation": "/core/check", "method": "POST", "description": "Validate configuration through Supervisor"},
    {"operation": "/core/{action}", "method": "POST", "description": "Core lifecycle: start, stop, restart, rebuild, update; updates accept version in body"},
    {"operation": "/addons", "method": "GET", "description": "Installed apps/add-ons"},
    {"operation": "/addons/{slug}/info", "method": "GET", "description": "App details and options"},
    {"operation": "/addons/{slug}/options", "method": "POST", "description": "Update app options with {options: {...}}; read current configuration first"},
    {"operation": "/addons/{slug}/{action}", "method": "POST", "description": "App lifecycle: start, stop, restart, install, uninstall, update, rebuild"},
    {"operation": "/addons/{slug}/logs", "method": "GET", "description": "App logs"},
    {"operation": "/addons/{slug}/stats", "method": "GET", "description": "App resource statistics"},
    {"operation": "/store", "method": "GET", "description": "App store catalog"},
    {"operation": "/store/reload", "method": "POST", "description": "Refresh local app definitions and repositories"},
    {"operation": "/backups", "method": "GET", "description": "List backups"},
    {"operation": "/backups/new/{kind}", "method": "POST", "description": "Create full or partial backup; kind=full|partial"},
    {"operation": "/backups/{slug}/restore/{kind}", "method": "POST", "description": "Restore full or partial backup"},
    {"operation": "/jobs/info", "method": "GET", "description": "Inspect Supervisor job progress after long-running operations"},
    {"operation": "/host/info", "method": "GET", "description": "Host system information"},
    {"operation": "/host/{action}", "method": "POST", "description": "Host reboot or shutdown"},
    {"operation": "/network/info", "method": "GET", "description": "Network interfaces"},
    {"operation": "/network/interface/{interface}/update", "method": "POST", "description": "Update interface configuration"},
    {"operation": "/os/info", "method": "GET", "description": "Operating system status"},
    {"operation": "/resolution/info", "method": "GET", "description": "Supervisor issues and suggestions"},
    {"operation": "/supervisor/logs", "method": "GET", "description": "Supervisor logs"}
  ]
}
